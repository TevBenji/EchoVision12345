# EchoVision configuration
#
# Every variable here is OPTIONAL. With no .env file at all, the app runs
# fully on the in-browser TensorFlow.js model and the browser's built-in
# speech engines — no keys, no accounts, no network calls to anyone.
#
# Copy to .env.local to use:  cp .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_ to the browser.

# --- Optional: external object detection --------------------------------
# Master switch. Leave false (or unset) to use the local model only.
# The local model is the only detection backend that is known to work end
# to end; see the Status section in the README before enabling these.
VITE_ENABLE_EXTERNAL_APIS=false

# Azure AI Vision. Create a "Computer Vision" resource in the Azure portal,
# then copy the endpoint and one of the two keys.
# https://portal.azure.com  ->  Create resource  ->  Computer Vision
# Free tier: F0 (20 calls/min, 5k calls/month).
VITE_AZURE_VISION_URL=
VITE_AZURE_VISION_KEY=

# DeepSeek. https://platform.deepseek.com -> API keys
# NOTE: the DeepSeek code path currently performs no network request and
# simply returns local-model results. Setting these has no effect today.
VITE_DEEPSEEK_URL=
VITE_DEEPSEEK_KEY=

# Generic cloud detection endpoint — any HTTP service accepting
# { image: "<base64>", options: {...} } and returning { objects: [...] }.
# Self-host one, or leave blank.
VITE_CLOUD_DETECTION_URL=
VITE_CLOUD_DETECTION_KEY=
